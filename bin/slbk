#!/usr/bin/env python3
"""Selects lines from input files (or stdin) based on a set of keys from a key file."""

import argparse
import io
import sys
from typing import List, Optional, Set, TextIO, Tuple


def parse_column_range(value: str) -> List[int]:
    """
    Parses a 0-based column range string (e.g., '1,3-5') into a list of
    0-based indices.
    """
    if not value:
        return []
    indices: set[int] = set()
    for part in value.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            try:
                start, end = map(int, part.split("-"))
                if start < 0 or end < 0:
                    msg = f"Column numbers must be positive, but got '{part}'."
                    raise argparse.ArgumentTypeError(msg)
                if start > end:
                    msg = f"Start of range must not be greater than end, but got '{part}'."
                    raise argparse.ArgumentTypeError(msg)
                indices.update(range(start, end))
            except ValueError as e:
                msg = f"Invalid range format: '{part}'."
                raise argparse.ArgumentTypeError(msg) from e
        else:
            try:
                col = int(part)
                if col < 0:
                    msg = f"Column number must be positive, but got '{col}'."
                    raise argparse.ArgumentTypeError(msg)
                indices.add(col)
            except ValueError as e:
                msg = f"Invalid column number: '{part}'."
                raise argparse.ArgumentTypeError(msg) from e
    return sorted(indices)


def get_key_from_line(
    line: str,
    columns: Optional[List[int]],
    delimiter: str,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> Optional[Tuple[str, ...]]:
    """Extracts and normalizes a key tuple from a line."""
    line_parts = [part.strip() for part in line.split(delimiter)]

    if columns:
        try:
            key_parts = [line_parts[i] for i in columns]
        except IndexError:
            sys.stderr.write(f"Warning: Line has fewer columns than specified. Skipping line: '{line.rstrip()}'\n")
            return None
    else:
        key_parts = line_parts

    processed_key_parts = []
    for part in key_parts:
        if ignore_case:
            part = part.upper()
        if ignore_space:
            part = "".join(part.split())
        if strip_http:
            part = part.removeprefix("http://").removeprefix("https://")
        processed_key_parts.append(part)

    return tuple(processed_key_parts)


def load_keys(
    key_stream: TextIO,
    columns: Optional[List[int]],
    delimiter: str,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> Set[Tuple[str, ...]]:
    """Reads the key file and returns a set of normalized keys."""
    keys = set()
    for line in key_stream:
        line = line.rstrip("\n")
        if not line:
            continue
        key = get_key_from_line(line, columns, delimiter, ignore_case, ignore_space, strip_http)
        if key is not None:
            keys.add(key)
    return keys


def process_inputs(
    input_streams: List[TextIO],
    keys: Set[Tuple[str, ...]],
    columns: Optional[List[int]],
    delimiter: str,
    invert_match: bool,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> None:
    """Processes input streams and prints matching/non-matching lines."""
    for stream in input_streams:
        for line in stream:
            original_line = line.rstrip("\n")
            key = get_key_from_line(original_line, columns, delimiter, ignore_case, ignore_space, strip_http)
            if key is None:
                continue

            is_in_keys = key in keys
            if invert_match:
                if not is_in_keys:
                    print(original_line)
            elif is_in_keys:
                print(original_line)


def main():
    """Main function to parse arguments and run the selection logic."""
    examples = """
Examples:
  # Select lines from 'data.csv' where the 2nd column matches any value in the 1st column of 'keys.txt'
  slbk -f keys.txt -k 1 -K 2 -d ',' -D ',' data.csv

  # Find users in 'log.txt' that are NOT in the 'banned_users.txt' list, ignoring case
  slbk -f banned_users.txt -r -i log.txt

  # Match data from stdin using a key file with 'gbk' encoding
  cat data.tsv | slbk -f keys.tsv -e gbk
"""
    parser = argparse.ArgumentParser(
        description="Select lines from files based on a key file. Acts like a 'grep' for structured data.",
        epilog=examples,
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument(
        "files", nargs="*", metavar="FILE", help="Input file(s) to process. If not provided, reads from stdin."
    )
    parser.add_argument("-f", "--key-file", required=True, help="The file containing the keys to match against.")
    parser.add_argument(
        "-k",
        "--key-file-cols",
        type=parse_column_range,
        default=None,
        help="1-based column indices for the key file. Use the whole line if not specified.\n"
        "Examples:\n"
        "  '0'       - Use the first column.\n"
        "  '0,2'     - Use the first and third columns.\n"
        "  '2-4'     - Use columns 2, 3, and 4.\n"
        "  '1,5-7'   - Use columns 1, 5, 6, and 7.",
    )
    parser.add_argument(
        "-K",
        "--input-file-cols",
        type=parse_column_range,
        default=None,
        help="1-based column indices for the input file(s).\nDefaults to the same columns as the key file (-k).",
    )
    parser.add_argument(
        "-d", "--key-delimiter", default="\t", help="Delimiter for fields in the key file. Default is TAB."
    )
    parser.add_argument(
        "-D", "--input-delimiter", default="\t", help="Delimiter for fields in the input file(s). Default is TAB."
    )
    parser.add_argument("-e", "--key-encoding", default="utf-8", help="Encoding for the key file. Default is 'utf-8'.")
    parser.add_argument(
        "-E",
        "--input-encoding",
        default=None,
        help="Encoding for the input file(s). Defaults to the key file's encoding (-e).",
    )
    parser.add_argument(
        "-r",
        "--reverse-match",
        action="store_true",
        default=False,
        help="Invert the match. Select lines that are NOT in the key file.",
    )
    parser.add_argument(
        "-i", "--ignore-case", action="store_true", default=False, help="Ignore case distinctions in keys."
    )
    parser.add_argument(
        "-I",
        "--ignore-space",
        action="store_true",
        default=False,
        help="Ignore all whitespace within key fields during comparison.",
    )
    parser.add_argument(
        "-H",
        "--strip-http",
        action="store_true",
        default=False,
        help='Strip "http://" and "https://" prefixes from keys before comparison.',
    )

    args = parser.parse_args()

    # If input columns aren't specified, they default to key columns.
    if args.input_file_cols is None:
        args.input_file_cols = args.key_file_cols
    # If key columns aren't specified, they default to input columns.
    # This handles the case where only -K is provided.
    if args.key_file_cols is None:
        args.key_file_cols = args.input_file_cols
    # If input encoding isn't specified, it defaults to key encoding.
    if args.input_encoding is None:
        args.input_encoding = args.key_encoding

    input_streams_to_close = []
    try:
        with open(args.key_file, encoding=args.key_encoding) as key_stream:
            keys = load_keys(
                key_stream,
                args.key_file_cols,
                args.key_delimiter,
                args.ignore_case,
                args.ignore_space,
                args.strip_http,
            )

        if args.files:
            input_streams = [open(f, encoding=args.input_encoding) for f in args.files]
            input_streams_to_close.extend(input_streams)
        else:
            input_streams = [io.TextIOWrapper(sys.stdin.buffer, encoding=args.input_encoding)]

        process_inputs(
            input_streams,
            keys,
            args.input_file_cols,
            args.input_delimiter,
            args.reverse_match,
            args.ignore_case,
            args.ignore_space,
            args.strip_http,
        )

    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"An unexpected error occurred: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        for stream in input_streams_to_close:
            stream.close()


if __name__ == "__main__":
    main()
