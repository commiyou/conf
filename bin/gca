#!/bin/bash

# ANSI 颜色
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RESET="\033[0m"

# 检查是否有 staged 改动
if git diff --staged --quiet; then
    echo -e "${YELLOW}No staged changes to commit.${RESET}"
    exit 0
fi

# 显示 staged 的 diff
git diff --staged

# 函数：按键确认 y/n，最多 3 次
confirm_key() {
    local prompt="$1"
    local attempt=0
    local max_attempts=3
    local key
    while ((attempt < max_attempts)); do
        read -rn1 -p "$prompt (y/n) " key
        echo
        case "$key" in
        [Yy]) return 0 ;;
        [Nn]) return 1 ;;
        *) echo -e "${YELLOW}Invalid input. Please type y or n.${RESET}" ;;
        esac
        ((attempt++))
    done
    return 1
}

# 询问用户是否生成 commit message
if ! confirm_key "Do you want to generate a commit message from this diff?"; then
    echo -e "${RED}Aborted.${RESET}"
    exit 0
fi

# 调用 sgpt 生成较完整的 commit message
commit_msg=$(git diff --staged | sgpt "Based on the following git diff, generate a commit message that follows the Conventional Commits specification. 
Include a detailed description after the first line. Only output the commit message, do NOT include explanations or extra text.

diff:")

# 显示生成的 commit message（凸显）
echo
echo -e "${CYAN}==================== Generated Commit Message ====================${RESET}"
echo -e "${GREEN}$commit_msg${RESET}"
echo -e "${CYAN}==================================================================${RESET}"
echo

# 用户确认是否 commit
if confirm_key "Do you want to commit with this message?"; then
    git commit -m "$commit_msg"
    echo -e "${GREEN}Committed!${RESET}"
else
    echo -e "${RED}Aborted.${RESET}"
fi
