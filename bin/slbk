#!/usr/bin/env python3
"""Selects lines from input files (or stdin) based on a set of keys from a key file."""

import argparse
import io
import sys
from typing import List, Optional, Set, TextIO, Tuple


def parse_column_range(value: str) -> List[int]:
    """
    Parses a 0-based, inclusive column range string (e.g., '0,2-4') into a list of
    0-based indices.
    """
    if not value:
        return []
    indices: set[int] = set()
    for part in value.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            try:
                start, end = map(int, part.split("-"))
                if start < 0 or end < 0:
                    msg = f"Column numbers must be non-negative, but got '{part}'."
                    raise argparse.ArgumentTypeError(msg)
                if start > end:
                    msg = f"Start of range must not be greater than end, but got '{part}'."
                    raise argparse.ArgumentTypeError(msg)
                indices.update(range(start, end + 1))  # Make range inclusive
            except ValueError as e:
                msg = f"Invalid range format: '{part}'."
                raise argparse.ArgumentTypeError(msg) from e
        else:
            try:
                col = int(part)
                if col < 0:
                    msg = f"Column number must be non-negative, but got '{col}'."
                    raise argparse.ArgumentTypeError(msg)
                indices.add(col)
            except ValueError as e:
                msg = f"Invalid column number: '{part}'."
                raise argparse.ArgumentTypeError(msg) from e
    return sorted(indices)


def get_key_from_line(
    line: str,
    columns: Optional[List[int]],
    delimiter: str,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> Optional[Tuple[str, ...]]:
    """Extracts and normalizes a key tuple from a line."""
    line_parts = [part.strip() for part in line.split(delimiter)]

    if columns:
        try:
            key_parts = [line_parts[i] for i in columns]
        except IndexError:
            sys.stderr.write(f"Warning: Line has fewer columns than specified. Skipping line: '{line.rstrip()}'\n")
            return None
    else:
        key_parts = line_parts

    processed_key_parts = []
    for part in key_parts:
        if ignore_case:
            part = part.upper()
        if ignore_space:
            part = "".join(part.split())
        if strip_http:
            part = part.removeprefix("http://").removeprefix("https://")
        processed_key_parts.append(part)

    return tuple(processed_key_parts)


def load_keys(
    key_stream: TextIO,
    columns: Optional[List[int]],
    delimiter: str,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> Set[Tuple[str, ...]]:
    """Reads the key file and returns a set of normalized keys."""
    keys = set()
    for line in key_stream:
        line = line.rstrip("\n")
        if not line:
            continue
        key = get_key_from_line(line, columns, delimiter, ignore_case, ignore_space, strip_http)
        if key is not None:
            keys.add(key)
    return keys


def process_inputs(
    input_streams: List[TextIO],
    keys: Set[Tuple[str, ...]],
    columns: Optional[List[int]],
    delimiter: str,
    invert_match: bool,
    ignore_case: bool,
    ignore_space: bool,
    strip_http: bool,
) -> None:
    """Processes input streams and prints matching/non-matching lines."""
    for stream in input_streams:
        for line in stream:
            original_line = line.rstrip("\n")
            key = get_key_from_line(original_line, columns, delimiter, ignore_case, ignore_space, strip_http)
            if key is None:
                continue

            is_in_keys = key in keys
            if invert_match:
                if not is_in_keys:
                    print(original_line)
            elif is_in_keys:
                print(original_line)


def run_tests():
    """Runs a series of self-tests to verify the script's functionality."""
    import os
    import shlex
    import shutil
    import subprocess
    import tempfile
    import textwrap

    script_path = __file__
    test_cases = []

    test_dir = tempfile.mkdtemp(prefix="slbk_tests_")

    try:
        keys_path = os.path.join(test_dir, "keys.txt")
        keys2_path = os.path.join(test_dir, "keys2.txt")
        data_path = os.path.join(test_dir, "data.txt")

        with open(keys_path, "w") as f:
            f.write("apple\nbanana\n")
        with open(keys2_path, "w") as f:
            f.write("cherry\n")
        with open(data_path, "w") as f:
            f.write("apple,1\nbanana,2\nCHERRY,3\norange,4\n")

        # Common arguments for tests using the sample data
        common_args = f"-k 0 -K 0 -d , -D ,"

        # Test Case 1: Basic selection
        test_cases.append(
            {
                "name": "Test 1: Basic selection",
                "args": f"-f {keys_path} {common_args} {data_path}",
                "output": textwrap.dedent("""
                    apple,1
                    banana,2
                """).lstrip(),
            }
        )

        # Test Case 2: Reverse match
        test_cases.append(
            {
                "name": "Test 2: Reverse match (-r)",
                "args": f"-f {keys_path} {common_args} -r {data_path}",
                "output": textwrap.dedent("""
                    CHERRY,3
                    orange,4
                """).lstrip(),
            }
        )

        # Test Case 3: Multiple key files and case-insensitivity
        test_cases.append(
            {
                "name": "Test 3: Multiple key files and case-insensitivity (-i)",
                "args": f"-f {keys_path} -f {keys2_path} {common_args} -i {data_path}",
                "output": textwrap.dedent("""
                    apple,1
                    banana,2
                    CHERRY,3
                """).lstrip(),
            }
        )

        # Test Case 4: File not found
        test_cases.append(
            {
                "name": "Test 4: Key file not found",
                "args": f"-f non_existent_file.txt {data_path}",
                "should_fail": True,
                "expected_stderr": "No such file or directory",
            }
        )

        print(f"Running {len(test_cases)} tests in '{test_dir}'...")
        failures = 0
        for i, case in enumerate(test_cases):
            print(f"--- {case['name']} ---")
            command = [sys.executable, script_path] + shlex.split(case["args"])
            should_fail = case.get("should_fail", False)

            process = subprocess.run(command, capture_output=True, text=True, encoding="utf-8")

            if should_fail:
                if process.returncode != 0 and case["expected_stderr"] in process.stderr:
                    print("\033[92mPASS\033[0m (Process failed as expected)")
                else:
                    failures += 1
                    print(f"\033[91mFAIL\033[0m: Process was expected to fail but did not, or stderr mismatch.")
                    print(f"Return Code: {process.returncode}")
                    print(f"Stderr:\n{process.stderr}")
            else:
                if process.returncode == 0 and process.stdout.strip() == case["output"].strip():
                    print("\033[92mPASS\033[0m")
                else:
                    failures += 1
                    print("\033[91mFAIL\033[0m")
                    print(f"Return Code: {process.returncode}")
                    print("Expected Stdout:")
                    print(textwrap.indent(case["output"], "> "))
                    print("Actual Stdout:")
                    print(textwrap.indent(process.stdout, "> "))
                    if process.stderr:
                        print("Stderr:")
                        print(textwrap.indent(process.stderr, "> "))
            print()

    finally:
        shutil.rmtree(test_dir)

    if failures > 0:
        print(f"Result: {failures} of {len(test_cases)} tests failed.")
        sys.exit(1)
    else:
        print("Result: All tests passed.")
        sys.exit(0)


def main():
    """Main function to parse arguments and run the selection logic."""
    if "--test" in sys.argv:
        run_tests()
        return

    examples = """
Examples:
  # Select lines from 'data.csv' where the 2nd column (index 1) matches any value in the 1st column (index 0) of 'keys.txt'
  slbk -f keys.txt -k 0 -K 1 -d ',' -D ',' data.csv

  # Find users in 'log.txt' that are NOT in the 'banned_users.txt' list, ignoring case
  slbk -f banned_users.txt -r -i log.txt

  # Match data from stdin using a key file with 'gbk' encoding
  cat data.tsv | slbk -f keys.tsv -e gbk
"""
    parser = argparse.ArgumentParser(
        description="Select lines from files based on a key file. Acts like a 'grep' for structured data.",
        epilog=examples,
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("--test", action="store_true", help="Run internal self-tests and exit.")
    parser.add_argument(
        "files", nargs="*", metavar="FILE", help="Input file(s) to process. If not provided, reads from stdin."
    )
    parser.add_argument(
        "-f",
        "--key-file",
        action="append",
        help="The file(s) containing the keys to match against. Can be specified multiple times.",
    )
    parser.add_argument(
        "-k",
        "--key-file-cols",
        type=parse_column_range,
        default=None,
        help="0-based column indices for the key file. Use the whole line if not specified.\n"
        "Examples:\n"
        "  '0'       - Use the first column.\n"
        "  '0,2'     - Use the first and third columns.\n"
        "  '2-4'     - Use columns 2, 3, and 4 (inclusive).\n"
        "  '1,5-7'   - Use columns 1, 5, 6, and 7.",
    )
    parser.add_argument(
        "-K",
        "--input-file-cols",
        type=parse_column_range,
        default=None,
        help="0-based column indices for the input file(s).\nDefaults to the same columns as the key file (-k).",
    )
    parser.add_argument(
        "-d", "--key-delimiter", default="\t", help="Delimiter for fields in the key file. Default is TAB."
    )
    parser.add_argument(
        "-D", "--input-delimiter", default="\t", help="Delimiter for fields in the input file(s). Default is TAB."
    )
    parser.add_argument("-e", "--key-encoding", default="utf-8", help="Encoding for the key file. Default is 'utf-8'.")
    parser.add_argument(
        "-E",
        "--input-encoding",
        default=None,
        help="Encoding for the input file(s). Defaults to the key file's encoding (-e).",
    )
    parser.add_argument(
        "-r",
        "--reverse-match",
        action="store_true",
        default=False,
        help="Invert the match. Select lines that are NOT in the key file.",
    )
    parser.add_argument(
        "-i", "--ignore-case", action="store_true", default=False, help="Ignore case distinctions in keys."
    )
    parser.add_argument(
        "-I",
        "--ignore-space",
        action="store_true",
        default=False,
        help="Ignore all whitespace within key fields during comparison.",
    )
    parser.add_argument(
        "-H",
        "--strip-http",
        action="store_true",
        default=False,
        help='Strip "http://" and "https://" prefixes from keys before comparison.',
    )

    args = parser.parse_args()

    if not args.key_file and not args.test:
        parser.error("the following arguments are required: -f/--key-file")

    # If input columns aren't specified, they default to key columns.
    if args.input_file_cols is None:
        args.input_file_cols = args.key_file_cols
    # If key columns aren't specified, they default to input columns.
    # This handles the case where only -K is provided.
    if args.key_file_cols is None:
        args.key_file_cols = args.input_file_cols
    # If input encoding isn't specified, it defaults to key encoding.
    if args.input_encoding is None:
        args.input_encoding = args.key_encoding

    input_streams_to_close = []
    try:
        keys = set()
        if args.key_file:
            for key_file_path in args.key_file:
                with open(key_file_path, encoding=args.key_encoding) as key_stream:
                    keys.update(
                        load_keys(
                            key_stream,
                            args.key_file_cols,
                            args.key_delimiter,
                            args.ignore_case,
                            args.ignore_space,
                            args.strip_http,
                        )
                    )

        if args.files:
            input_streams = [open(f, encoding=args.input_encoding) for f in args.files]
            input_streams_to_close.extend(input_streams)
        else:
            input_streams = [io.TextIOWrapper(sys.stdin.buffer, encoding=args.input_encoding)]

        process_inputs(
            input_streams,
            keys,
            args.input_file_cols,
            args.input_delimiter,
            args.reverse_match,
            args.ignore_case,
            args.ignore_space,
            args.strip_http,
        )

    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"An unexpected error occurred: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        for stream in input_streams_to_close:
            stream.close()


if __name__ == "__main__":
    main()
