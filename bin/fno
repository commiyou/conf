#!/usr/bin/env python3
"""
Field Number Output (fno) - A utility to display numbered fields from delimited text files.

This script reads text files line-by-line and displays each field of a selected
line with its index number, making it easy to identify field positions for data
processing tasks. It operates in a streaming fashion to handle large files efficiently.
"""

import random
import re
import sys
from typing import IO, List, Optional, Tuple

import click


def cjk_width(s: str) -> int:
    """
    Calculate the display width of a string, treating CJK characters as 2 cells wide.

    Args:
        s: The input string.

    Returns:
        The calculated display width.
    """
    return sum(2 if "\u4e00" <= char <= "\u9fff" else 1 for char in s)


def safe_expr_eval(expr: str, fields: List[str], line: str) -> bool:
    """
    Safely evaluate a simple, AWK-like expression against field values.

    This function avoids `eval()` and manually parses expressions for basic
    comparisons and regex matching, supporting formats like "$1 == 'value'"
    or "$NF ~ /pattern/".

    Args:
        expr: The expression string to evaluate.
        fields: A list of the fields from the current line.
        line: The raw line content ($0).

    Returns:
        True if the expression matches, False otherwise.
    """
    if not expr:
        return True

    def get_field_value(field_spec: str) -> str:
        """Helper to get field value from specifier like $1, $NF."""
        if field_spec == "$0":
            return line
        if field_spec == "$NF":
            return fields[-1] if fields else ""
        if field_spec.startswith("$") and field_spec[1:].isdigit():
            try:
                field_num = int(field_spec[1:])
                if 1 <= field_num <= len(fields):
                    return fields[field_num - 1]
            except (ValueError, IndexError):
                return ""
        return ""

    # Pattern for regex matching: $N ~ /regex/ or $N !~ /regex/
    match_re = re.match(r"(\\(?:\\d+|NF|0))\s*(!?~)\s*/(.*?)/$", expr)
    if match_re:
        field_spec, op, pattern = match_re.groups()
        field_value = get_field_value(field_spec)
        try:
            is_match = bool(re.search(pattern, field_value, flags=re.IGNORECASE))
        except re.error:
            is_match = False  # Invalid regex pattern
        return not is_match if op == "!~" else is_match

    # Pattern for simple equality/inequality: $N == 'value' or $N != "value"
    comp_re = re.match(r"(\\(?:\\d+|NF|0))\s*(==|!=)\s*['\"](.*?)['\"]$", expr)
    if comp_re:
        field_spec, op, value = comp_re.groups()
        field_value = get_field_value(field_spec)
        return (field_value != value) if op == "!=" else (field_value == value)

    return False


def try_decode(line: bytes) -> str:
    """
    Attempt to decode a byte string using common encodings.

    Args:
        line: Input bytes to decode.

    Returns:
        A decoded string.
    """
    if isinstance(line, str):
        return line
    for encoding in ["utf-8", "gb18030", "latin1"]:
        try:
            return line.decode(encoding)
        except UnicodeDecodeError:
            continue
    return line.decode("utf-8", errors="ignore")


def print_formatted_line(line: str, headers: Optional[List[str]], delim: str, line_num: int, max_width: int):
    """
    Formats and prints a single line with field numbers, headers, and alignment.

    Args:
        line: The content of the line to print.
        headers: An optional list of header names.
        delim: The field delimiter.
        line_num: The line number to display.
        max_width: The maximum display width for a field before truncating.
    """
    # Check TTY for both stdout and stderr to apply colors conditionally
    is_stdout_tty = sys.stdout.isatty()
    is_stderr_tty = sys.stderr.isatty()

    # Colors for stdout
    C_IDX = "\033[35m" if is_stdout_tty else ""  # Magenta for index
    C_HDR = "\033[36m" if is_stdout_tty else ""  # Cyan for header
    C_END = "\033[32m" if is_stdout_tty else ""  # Green for end marker
    C_TRUNC = "\033[32m" if is_stdout_tty else ""  # Yellow for truncation
    C_RESET = "\033[0m" if is_stdout_tty else ""

    # Colors for stderr
    C_LNO = "\033[34m" if is_stderr_tty else ""  # Blue for line number
    C_RESET_ERR = "\033[0m" if is_stderr_tty else ""

    def truncate_by_width(s: str, max_w: int) -> str:
        """Truncates a string to a max display width, respecting CJK chars."""
        width, pos = 0, 0
        for char in s:
            char_w = 2 if "\u4e00" <= char <= "\u9fff" else 1
            if width + char_w > max_w:
                break
            width += char_w
            pos += 1
        return s[:pos]

    fields = line.strip("\n").split(delim)
    print(f"{C_LNO}== line no: {line_num}{C_RESET_ERR}", file=sys.stderr)

    def get_end_marker(value: str) -> str:
        return f"{C_END}$ {C_RESET}" if value and value.rstrip() != value else ""

    if headers:
        max_num_width = len(str(len(fields) - 1))
        max_header_width = 0
        for i in range(len(headers)):
            if i < len(fields):
                max_header_width = max(max_header_width, cjk_width(f"({headers[i]})"))

        for i, field_value in enumerate(fields):
            num_part = f"{i:>{max_num_width}}"
            display_value = field_value
            end_marker = get_end_marker(field_value)

            if max_width > 0 and cjk_width(field_value) > max_width:
                trunc_str = truncate_by_width(field_value, max_width)
                display_value = trunc_str + f"{C_TRUNC}...{C_RESET}"
                end_marker = ""

            if i < len(headers):
                header_part = f"({headers[i]})"
                padding = " " * (max_header_width - cjk_width(header_part))
                colored_header = f"{C_HDR}{header_part}{C_RESET}"
                colored_num = f"{C_IDX}{num_part}{C_RESET}"
                print(f"{colored_num} {colored_header}{padding} : {display_value}{end_marker}")
            else:
                padding = " " * (max_header_width + 2)
                colored_num = f"{C_IDX}{num_part}{C_RESET}"
                print(f"{colored_num}{padding} : {display_value}{end_marker}")
    else:
        max_field_num_width = max(5, len(str(len(fields) - 1)))
        for i, field_value in enumerate(fields):
            display_value = field_value
            end_marker = get_end_marker(field_value)

            if max_width > 0 and cjk_width(field_value) > max_width:
                trunc_str = truncate_by_width(field_value, max_width)
                display_value = trunc_str + f"{C_TRUNC}...{C_RESET}"
                end_marker = ""

            num_part = f"{i:>{max_field_num_width}}"
            colored_num = f"{C_IDX}{num_part}{C_RESET}"
            print(f"{colored_num} : {display_value}{end_marker}")


def reservoir_sample_from_stream(stream: IO, expr: str, delim: str, sample_size: int) -> Optional[Tuple[str, int]]:
    """
    Selects a random line from the first `sample_size` lines of a stream
    that match the given expression, using reservoir sampling.
    """
    selected_item = None
    filtered_count = 0
    for i, line_bytes in enumerate(stream):
        if i >= sample_size:
            break
        line = try_decode(line_bytes)
        fields = line.strip("\n").split(delim)
        if not safe_expr_eval(expr, fields, line):
            continue
        filtered_count += 1
        if random.randrange(filtered_count) == 0:
            selected_item = (line, i + 1)
    return selected_item


def find_and_print_target_line(
    stream: IO, lineno: int, expr: str, delim: str, headers: Optional[List[str]], max_width: int
):
    """
    Finds the `lineno`-th line in the stream that matches the expression and prints it.
    """
    filtered_lineno = -1
    for i, line_bytes in enumerate(stream):
        line = try_decode(line_bytes)
        fields = line.strip("\n").split(delim)
        if not safe_expr_eval(expr, fields, line):
            continue
        filtered_lineno += 1
        if filtered_lineno == lineno:
            print_formatted_line(line, headers, delim, line_num=i + (2 if headers else 1), max_width=max_width)
            return
    print(f"Error: Line number {lineno} not found after filtering.", file=sys.stderr)


@click.command(context_settings=dict(help_option_names=["-h", "--help"]))
@click.option("-d", "--delim", default="\t", help="Field delimiter. Default is tab.")
@click.option(
    "-l", "--lineno", default=0, type=int, help="0-based line number to print after filtering. Default is 0."
)
@click.option(
    "-r",
    "--random-line",
    is_flag=True,
    default=False,
    help="Randomly select a line to print from the sample.",
)
@click.option(
    "--sample-size",
    default=1000,
    type=int,
    help="Number of lines to sample for --random-line. Default is 1000.",
)
@click.option(
    "-w",
    "--max-width",
    default=1000,
    type=int,
    help="Truncate fields wider than this. 0 for no limit. Default is 1000.",
)
@click.option("-H", "--header/--no-header", default=False, help="Treat the first line as a header.")
@click.option(
    "-e",
    "--expr",
    default=None,
    help='Filter expression (e.g. "$1==\'value\'" or "$2 ~ /pattern/").',
)
@click.argument("files", nargs=-1, type=click.File("rb"))
def main(
    delim: str,
    lineno: int,
    random_line: bool,
    sample_size: int,
    max_width: int,
    header: bool,
    expr: str,
    files: Tuple[IO, ...],
):
    """
    Pretty print the fields of one line in a file with field numbers.
    """
    if not files:
        stdin_stream = (line.encode("utf-8") for line in sys.stdin)
        files = (stdin_stream,)  # type: ignore

    for fd in files:
        headers = None
        header_line_num = 0
        if header:
            try:
                header_line = try_decode(next(fd))
                headers = header_line.strip("\n").split(delim)
                header_line_num = 1
            except StopIteration:
                continue

        if random_line:
            selected = reservoir_sample_from_stream(fd, expr, delim, sample_size)
            if selected:
                line, num = selected
                print_formatted_line(line, headers, delim, line_num=num + header_line_num, max_width=max_width)
            else:
                print("No matching lines found in the sample.", file=sys.stderr)
        else:
            find_and_print_target_line(fd, lineno, expr, delim, headers, max_width)


if __name__ == "__main__":
    main()
