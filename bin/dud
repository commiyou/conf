#!/bin/sh
# Show disk usage for current-directory entries or explicitly supplied paths.
# This is a real command so it works from sudo and non-zsh shells.

set -eu

if [ "$#" -eq 0 ]; then
  set -- ./*
  if [ "$1" = './*' ] && [ ! -e "$1" ]; then
    exit 0
  fi
elif [ "$1" = '--' ]; then
  shift
  [ "$#" -gt 0 ] || {
    printf '%s\n' 'dud: -- requires at least one path' >&2
    exit 2
  }
fi

# GNU du accepts "--"; BSD du (including macOS) does not.
if du -sh -- . >/dev/null 2>&1; then
  du_args='--'
else
  du_args=''
fi

if sort -h </dev/null >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  du -sch $du_args "$@" | sort -h
else
  # shellcheck disable=SC2086
  du -sch $du_args "$@"
fi
