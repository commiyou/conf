#!/usr/bin/env python3
"""
Field Number Output (fno) - A utility to display numbered fields from delimited text files.

This script reads text files and displays each field with its index number,
making it easy to identify field positions for data processing tasks.
"""

import random
import subprocess
import sys

import click


def cjk_width(s: str) -> int:
    """
    Calculate the display width of a string, treating CJK characters as 2 cells wide.
    """
    # A simple check for CJK Unified Ideographs range
    return sum(2 if '\u4e00' <= char <= '\u9fff' else 1 for char in s)


def evaluate_awk_expr(expr: str, fields: list[str], line: str) -> bool:
    """
    Evaluate AWK-style expression against field values.

    Args:
        expr: AWK-style expression (e.g. "$1=='value'" or "$NF>100" or "$1 ~ /pattern/")
        fields: List of field values
        line: The original line, for $0.

    Returns:
        Boolean result of expression evaluation
    """
    if not expr:
        return True

    import re

    safe_expr = expr

    def get_field_value(field_spec: str) -> str:
        """Helper to get field value from specifier like $1, $NF."""
        if field_spec == "$0":
            return line
        if field_spec == "$NF":
            return fields[-1] if fields else ""
        if field_spec.startswith("$") and field_spec[1:].isdigit():
            field_num = int(field_spec[1:])
            if 1 <= field_num <= len(fields):
                return fields[field_num - 1]
        return ""

    # Regex to find AWK-style pattern matching expressions, e.g., $1 ~ /foo/
    # It captures: 1. field specifier, 2. operator, 3. pattern
    pattern_re = re.compile(r"(\$(?:\d+|NF|0))\s*(!?~)\s*\/((?:\\\/|[^\/])+)\/")

    def replace_match_expr(m) -> str:
        """Replacement function for re.sub to evaluate pattern matches."""
        field_spec, op, pattern = m.groups()
        field_value = get_field_value(field_spec)
        pattern = pattern.replace("\\/", "/")  # Unescape slashes in pattern

        re_flags = 0
        if pattern.islower():
            re_flags = re.IGNORECASE

        try:
            is_match = bool(re.search(pattern, field_value, flags=re_flags))
        except re.error:
            # Invalid regex in user expression
            return "False"

        if op == "!~":
            is_match = not is_match

        return str(is_match)

    # First, evaluate and replace all regex match expressions
    safe_expr = pattern_re.sub(replace_match_expr, safe_expr)

    # Now, replace remaining field variables ($1, $NF, etc.) for other comparisons
    field_var_re = re.compile(r"(\$(?:\d+|NF|0))")

    def replace_field_var(m) -> str:
        """Replacement function for re.sub to replace field variables with their values."""
        field_spec = m.group(0)
        return repr(get_field_value(field_spec))

    safe_expr = field_var_re.sub(replace_field_var, safe_expr)

    try:
        # Use eval with restricted globals for safety
        return bool(eval(safe_expr, {"__builtins__": {}}, {}))
    except Exception:
        return False


def try_decode_str(line: str, encodings: list[str] = ["utf8", "gb18030"], errors: str = "strict"):
    """
    Attempt to decode a byte string using multiple encodings.

    Args:
        line: Input string or bytes to decode
        encodings: Tuple of encoding names to try in order
        errors: Error handling strategy for decoding

    Returns:
        Decoded string

    Raises:
        UnicodeError: If all encodings fail
    """
    if isinstance(line, str):
        return line
    if isinstance(encodings, str):
        encodings = [encodings]

    for encoding in encodings:
        try:
            line = line.decode(encoding, errors=errors)
        except:
            continue
        return line
    msg = "line[{}] decode error, coding list {}".format(line, ", ".join(encodings))
    raise UnicodeError(msg)


def get_encoding(encoding=None):
    """
    Get the appropriate encoding for text processing.

    Args:
        encoding: Explicit encoding to use, or None for auto-detection

    Returns:
        String encoding name, defaults to gb18030 if iso88591 is detected
    """
    import locale

    encoding = encoding or locale.getpreferredencoding() or sys.stdin.encoding or sys.getdefaultencoding()
    # Convert iso88591 to gb18030 for better Chinese character support
    if encoding.lower().replace("-", "") == "iso88591":
        encoding = "gb18030"
    return encoding


@click.command()
@click.option("-d", "--delim", help="delimeter, default tab", default="\t")
@click.option("-f", "--from-encoding", help="from encoding", default=None)
@click.option("-l", "--lineno", help="the line number to print, default 0", default=0)
@click.option("-r/ ", "--random-line/--norandom-line", help="randome select line to print(0-10000)", default=False)
@click.option("-h/ ", "--header/--no-header", help="treat first line as header", default=False)
@click.option("-e", "--expr", help="filter expression (e.g. \"$1=='手机品牌排行榜'\")", default=None)
@click.argument("files", nargs=-1, type=click.File())
def main(delim:str, from_encoding:str, lineno:int, random_line:bool, header:bool, expr:str, files:str):
    """
    Pretty print the fields of one line in file with field numbers.

    This function processes input files (or stdin) and displays each field
    with its index number, making it easy to identify field positions.

    Args:
        delim: Field delimiter (default: tab)
        from_encoding: Source encoding for input text
        to_encoding: Target encoding for output (currently unused)
        lineno: Specific line number to process (0-based, default: 0)
        random_line: Whether to randomly select a line instead of using lineno
        header: Whether to treat first line as header and show field names
        expr: AWK-style filter expression (e.g. "$1=='value'")
        files: Input file objects to process
    """
    if not files:
        files = [sys.stdin]

    for fd in files:
        # Display file information for non-stdin inputs
        if fd is not sys.stdin:
            print("== {}".format(subprocess.getoutput(f"file {fd.name}")), file=sys.stderr)

        all_lines = []
        headers = None

        # Read all lines and handle header if needed
        for line in fd:
            line = line.rstrip("\n")
            line = line.decode(from_encoding, errors="ignore") if from_encoding else try_decode_str(line)
            all_lines.append(line)

        if not all_lines:
            continue

        # Process header if specified
        if header and all_lines:
            headers = all_lines[0].split(try_decode_str(delim))
            data_lines = all_lines[1:]
        else:
            data_lines = all_lines

        selected_line = None
        selected_idx = None

        if not random_line:
            # Process lines sequentially to find the target line
            for idx, line in enumerate(data_lines):
                fields = line.split(try_decode_str(delim))

                # Apply expression filter if provided
                if not evaluate_awk_expr(expr, fields, line):
                    continue

                if selected_line is None:
                    selected_line = line
                    selected_idx = idx + (1 if header else 0)  # Adjust for header
                if idx == lineno:
                    selected_line = line
                    selected_idx = idx + (1 if header else 0)
                    break
        else:
            # Use reservoir sampling to randomly select a line
            max_tries = 10000
            filtered_lines = []

            # First filter lines based on expression
            for idx, line in enumerate(data_lines):
                fields = line.split(try_decode_str(delim))
                if evaluate_awk_expr(expr, fields, line):
                    filtered_lines.append((idx, line))

            if filtered_lines:
                # Apply reservoir sampling on filtered lines
                selected_line = filtered_lines[0][1]
                selected_idx = filtered_lines[0][0] + (1 if header else 0)

                for i, (idx, line) in enumerate(filtered_lines[1:], 2):
                    if random.randrange(i) == 0:
                        selected_line = line
                        selected_idx = idx + (1 if header else 0)
                    if i >= max_tries:
                        break

        if selected_line is None:
            continue

        delim_decoded = try_decode_str(delim)
        print(f"== line no: {selected_idx}", file=sys.stderr)

        # Note: Output encoding conversion is currently disabled
        # to_encoding = get_encoding(to_encoding)
        # line = line.encode(to_encoding)
        # delim = delim.encode(to_encoding)

        # Split line into fields and display with numbers and end markers
        fields = selected_line.split(delim_decoded)

        # --- Output Formatting ---
        # Define colors for output
        COLOR_HEADER = '\033[36m'  # Cyan
        COLOR_END_MARKER = '\033[32m'
        COLOR_RESET = '\033[0m'

        # Helper to determine if the end marker is needed
        def get_end_marker(value: str) -> str:
            # Show marker only if there's trailing whitespace
            if value and value.rstrip() != value:
                return f"{COLOR_END_MARKER}${COLOR_RESET}"
            return ""

        # Calculate maximum widths for alignment and print fields
        if headers:
            max_num_width = len(str(len(fields) - 1)) if fields else 1
            
            max_header_display_width = 0
            header_parts = []
            # Pre-calculate header parts and their max display width
            for i in range(len(headers)):
                part = f"({headers[i]})"
                header_parts.append(part)
                if i < len(fields):
                    max_header_display_width = max(max_header_display_width, cjk_width(part))

            for i, field_value in enumerate(fields):
                num_part = f"{i:>{max_num_width}}"
                end_marker = get_end_marker(field_value)

                if i < len(headers):
                    header_part = header_parts[i]
                    padding_width = max_header_display_width - cjk_width(header_part)
                    padding = ' ' * padding_width
                    colored_header = f"{COLOR_HEADER}{header_part}{COLOR_RESET}"
                    print(f"{num_part} {colored_header}{padding} : {field_value}{end_marker}")
                else:
                    padding = ' ' * (max_header_display_width + 2) # +2 for ()
                    print(f"{num_part} {padding} : {field_value}{end_marker}")
        else:
            # Original formatting for no-header mode
            max_width = 5
            if fields:
                max_width = max(max_width, len(str(len(fields) - 1)))

            for i, field_value in enumerate(fields):
                end_marker = get_end_marker(field_value)
                print(f"{i:>{max_width}} : {field_value}{end_marker}")


if __name__ == "__main__":
    main()
