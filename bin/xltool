#!/usr/bin/env python3
import sys
import typing

import fire
import openpyxl  # 需要引入 openpyxl 来读取隐藏的sheet信息
import pandas as pd

T = typing.TypeVar("T")


def _process_cell(value: T) -> T:
    """
    处理单个单元格的函数（内部使用）。
    1. 如果单元格内容是字符串，则替换回车符和换行符为空格。
    2. 对字符串进行strip()操作，去除首尾的空白字符。
    3. 如果不是字符串（如数字、日期），则保持原样。
    """
    if isinstance(value, str):
        return value.replace("\n", " ").replace("\r", " ").strip()  # type: ignore
    return value


def list_sheets(input_excel_path: str, n: int | None = None):
    """
    列出指定Excel文件中的所有工作表，包括隐藏的工作表。
    如果 n 为正数，每个 sheet 输出前 n 行内容。

    Args:
        input_excel_path (str): 输入的Excel文件路径。
        n (int, optional): 每个sheet要显示的前n行，默认为None只显示表名。
    """
    print(f"正在读取 Excel 文件: {input_excel_path} ...\n", file=sys.stderr)
    workbook = openpyxl.load_workbook(input_excel_path, read_only=True)

    print("找到以下工作表 (Sheets):")
    for i, sheet in enumerate(workbook.worksheets):
        visibility = "隐藏" if sheet.sheet_state != "visible" else "可见"
        print(f"{i}. 名称: '{sheet.title}', 状态: {visibility}")
        if n is not None and n > 0:
            try:
                df = pd.read_excel(input_excel_path, sheet_name=sheet.title, nrows=n, header=None)
                print(f"前{n}行:")
                print(df.to_string(index=False, header=False, col_space=0, justify="left"))
            except Exception as e:
                print(f"  [读取sheet内容失败: {e}]", file=sys.stderr)
            print("-" * 40)


def convert_excel_to_tsv(input_excel_path: str | None, output_tsv_path: str | None = None, sheet_name: str | int = 0):
    """
    将Excel文件的指定工作表转换为TSV文件，并处理每个单元格。

    Args:
        input_excel_path (str): 输入的Excel文件路径。
        output_tsv_path (str): 输出的TSV文件路径。
        sheet_name (str or int, optional): 要转换的工作表名称或索引。默认为0（第一个工作表）。
    """
    sheet_identifier = f"'{sheet_name}'" if isinstance(sheet_name, str) else f"索引 {sheet_name}"
    print(f"正在读取 Excel 文件: {input_excel_path} (工作表: {sheet_identifier}) ...", file=sys.stderr)

    # 读取Excel文件，通过 sheet_name 参数指定工作表
    df = pd.read_excel(input_excel_path, sheet_name=sheet_name, header=None)

    # print("正在处理所有单元格（替换回车、去除首尾空格）...")
    # 直接调用 _process_cell 函数
    df_processed = df.map(_process_cell)

    # print(f"正在保存为 TSV 文件: {output_tsv_path} ...")
    # 将处理后的 DataFrame 保存为 TSV 文件
    import csv

    df_processed.to_csv(
        output_tsv_path or sys.stdout, sep="\t", index=False, header=False, encoding="utf-8", quoting=csv.QUOTE_NONE
    )

    # print("\n转换成功！")
    # print(f"输入文件: {input_excel_path}")
    # print(f"目标工作表: {sheet_identifier}")
    print(f"输出文件: {output_tsv_path}", file=sys.stderr)


# --- 主程序入口 ---
if __name__ == "__main__":
    # 将希望暴露为命令行工具的函数放入一个字典中
    # 字典的键 'list-sheets' 将成为命令行的命令名称
    # 字典的值 list_sheets 是对应的函数
    fire.Fire(
        {
            "list-sheets": list_sheets,
            "convert-to-tsv": convert_excel_to_tsv,
        }
    )
