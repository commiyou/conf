#!/bin/bash

# ===================== 检查是否使用中文 commit message =====================
generate_cn=false
for arg in "$@"; do
    if [[ "$arg" == "-c" ]]; then
        generate_cn=true
        break
    fi
done

# ===================== 调用 sgpt 生成 commit message =====================

# ===================== 配色 =====================
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
RESET="\033[0m"

# ===================== 检查 staged 改动 =====================
if git diff --staged --quiet; then
    echo -e "${YELLOW}No staged changes to commit.${RESET}"
    exit 0
fi

# ===================== 显示 diff =====================
git diff --staged

# ===================== 按键确认函数 =====================
confirm_key() {
    local prompt="$1"
    local attempt=0
    local max_attempts=3
    local key
    while ((attempt < max_attempts)); do
        read -rn1 -p "$prompt (y/n) " key
        echo
        case "$key" in
        [Yy]) return 0 ;;
        [Nn]) return 1 ;;
        *) echo -e "${YELLOW}Invalid input. Please type y or n.${RESET}" ;;
        esac
        ((attempt++))
    done
    return 1
}

# ===================== 询问是否生成 commit message =====================
if ! confirm_key "Do you want to generate a commit message from this diff?"; then
    echo -e "${RED}Aborted.${RESET}"
    exit 0
fi

# ===================== 调用 sgpt 生成 commit message =====================
if [ "$generate_cn" = true ]; then
    raw_commit_msg=$(git diff --staged | sgpt "请根据以下 git diff，生成一个符合 Conventional Commits 规范的 commit message，要求：
1. 第一行为类型与简要说明，
2. 第二行开始为详细描述，
3. 仅输出 commit message，不要任何解释或多余内容。
4. 注意使用中文
diff:")
else
    raw_commit_msg=$(git diff --staged | sgpt "Based on the following git diff, generate a commit message that strictly follows the Conventional Commits specification.
Include a detailed description after the first line. Only output the commit message, do NOT include any explanations or extra text.

diff:")
fi

# ===================== 显示原始 LLM 输出（原样，无高亮） =====================
echo
echo "==================== Original LLM Output ===================="
echo "$raw_commit_msg"
echo "============================================================="
echo

# ===================== 处理 commit message =====================
ALLOWED_TYPES="feat|fix|chore|docs|style|refactor|perf|test"

commit_msg=$(echo "$raw_commit_msg" | awk -v types="$ALLOWED_TYPES" '
  # 去掉行首空格
  { gsub(/^[ \t]+/, "", $0) }
  found==0 && $0 ~ "^("types")" {found=1}
  found==1 {print}
')

# ===================== 显示最终 commit message（高亮） =====================
echo
echo -e "${CYAN}==================== Commit Message To Use ====================${RESET}"
echo -e "${GREEN}"
echo "$commit_msg" | fold -s -w 80
echo -e "${RESET}${CYAN}================================================================${RESET}"
echo

# ===================== 用户确认是否 commit =====================
if confirm_key "Do you want to commit with this message?"; then
    git commit -m "$commit_msg"
    echo -e "${GREEN}Committed!${RESET}"
else
    echo -e "${RED}Aborted.${RESET}"
fi
