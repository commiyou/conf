#!/usr/bin/env python3
"""
csbk is a tool for performing key-based aggregation (sum, count, avg, etc.)
on columnar data from the command line.
"""

import argparse
import codecs
import math
import sys
from collections import defaultdict
from io import StringIO
from typing import Dict, Iterable, List, TextIO, Tuple


def unescape_str(s: str) -> str:
    """Converts escape sequences like \\t to their character equivalent."""
    if s is None:
        return None
    return codecs.decode(s, "unicode_escape")


def parse_column_spec(spec_string: str) -> List[int]:
    """Parses a column specification string like '1,3-5,7' into a list of integers."""
    if not spec_string:
        return []
    indices = []
    parts = spec_string.split(",")
    for part in parts:
        if "-" in part:
            try:
                start, end = map(int, part.split("-"))
                if start > end:
                    raise ValueError(f"Invalid range: start > end in '{part}'")
                indices.extend(range(start, end + 1))
            except ValueError:
                raise ValueError(f"Invalid range in column spec: {part}")
        else:
            try:
                indices.append(int(part))
            except ValueError:
                raise ValueError(f"Invalid number in column spec: {part}")
    return sorted(list(set(indices)))


def bold(text: str) -> str:
    """Wraps text in ANSI codes for bold formatting."""
    return f"\033[1m{text}\033[0m"


class Aggregator:
    """Holds the state for all aggregations for a single value column."""

    def __init__(self):
        self.sum = 0.0
        self.count = 0
        self.min = float("inf")
        self.max = float("-inf")

    def update(self, value: float):
        self.sum += value
        self.count += 1
        self.min = min(self.min, value)
        self.max = max(self.max, value)

    def merge(self, other: "Aggregator"):
        """Merges another Aggregator's stats into this one."""
        self.sum += other.sum
        self.count += other.count
        self.min = min(self.min, other.min)
        self.max = max(self.max, other.max)

    def get(self, agg_func: str) -> float:
        if self.count == 0:
            return 0.0 if agg_func in ["sum", "count"] else float("nan")

        if agg_func == "sum":
            return self.sum
        if agg_func == "count":
            return self.count
        if agg_func == "avg":
            return self.sum / self.count
        if agg_func == "min":
            return self.min
        if agg_func == "max":
            return self.max
        raise ValueError(f"Unknown aggregation function: {agg_func}")


def process_streams(
    streams: Iterable[TextIO],
    delimiter: str,
    key_cols: List[int],
    value_cols: List[int],
    ignore_errors: bool,
) -> Tuple[Dict[Tuple, List[Aggregator]], int]:
    """Processes data, returning a dictionary of aggregators per key and an error count."""
    num_aggregators = len(value_cols) if value_cols else 1
    results = defaultdict(lambda: [Aggregator() for _ in range(num_aggregators)])
    error_count = 0

    for stream in streams:
        for line in stream:
            try:
                line = line.rstrip("\n")
                if not line:
                    continue
                fields = line.split(delimiter)
                key = tuple(fields[i] for i in key_cols)

                if value_cols:
                    for i, col_idx in enumerate(value_cols):
                        value = float(fields[col_idx])
                        results[key][i].update(value)
                else:
                    results[key][0].update(1.0)
            except (ValueError, IndexError) as e:
                error_count += 1
                if not ignore_errors:
                    print(f"Error on line: {line!r} -> {e}", file=sys.stderr)
                    raise
                else:
                    print(f"Skipping malformed line: {line!r}", file=sys.stderr)
    return dict(results), error_count


def format_value(value: float) -> str:
    """Formats a float, handling integers, floats, and NaN."""
    if math.isnan(value):
        return "na"
    return str(int(value)) if value == int(value) else f"{value:.2f}"


def pretty_print_table(header: List[str], data_rows: List[List[str]], total_row: List[str] = None):
    """Prints data in a `column -t` style table."""
    if not header and not data_rows:
        return

    all_rows = [header] + data_rows
    if total_row:
        all_rows.append(total_row)

    col_widths = [max(len(cell) for cell in col) for col in zip(*all_rows)]

    # Print Header
    header_line = "  ".join(f"{h:<{w}}" for h, w in zip(header, col_widths))
    print(bold(header_line))

    # Print Separator
    separator = "  ".join("-" * w for w in col_widths)
    print(bold(separator))

    # Print Data
    for row in data_rows:
        print("  ".join(f"{c:<{w}}" for c, w in zip(row, col_widths)))

    # Print Total if exists
    if total_row:
        print(bold(separator))
        total_line = "  ".join(f"{c:<{w}}" for c, w in zip(total_row, col_widths))
        print(bold(total_line))


def main():
    parser = argparse.ArgumentParser(
        description="Perform key-based aggregation on columnar data.",
        epilog="""
Examples:
  Suppose we have a file 'data.csv' with the content:
  user1,A,10
  user1,B,20
  user2,A,30

  1. Get count and sum for col 2, grouped by key in col 0.
     csbk -k 0 -v 2 -d "," data.csv
     Output:
     key_0,count_2,sum_2
     user1,2,30
     user2,1,30

  2. Get count, sum, and avg for col 2, grouped by key in col 0, in a pretty table:
     csbk -k 0 -v 2 -a avg -d "," -P data.csv
     Output:
     \033[1mkey_0  count_2  sum_2  avg_2\033[0m
     \033[1m-----  -------  -----  -----\033[0m
     user1  2        30     15.00
     user2  1        30     30.00

  3. Show percentages and a total row, sorted by sum:
     csbk -k 0 -v 2 -p --sort-by-value -d "," data.csv
     Output:
     key_0,count_2,count_2_pct,sum_2,sum_2_pct
     user1,2,66.67%,30,50.00%
     user2,1,33.33%,30,50.00%
     total,3,100.00%,60,100.00%
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-k", "--key-cols", help="Key columns, e.g., '0,1,3-5'.")
    parser.add_argument("-v", "--value-cols", help="Value columns to aggregate, e.g., '2,6-8'.")
    parser.add_argument(
        "-a",
        "--agg",
        action="append",
        choices=["sum", "count", "avg", "min", "max"],
        help="Additional aggregation functions.",
    )
    parser.add_argument(
        "-A",
        "--all-aggs",
        action="store_true",
        help="Use all available aggregation functions (sum, count, avg, min, max).",
    )
    parser.add_argument("-d", "--delimiter", help=r"Input field delimiter (e.g., '\t' for tab).", default="\t")
    parser.add_argument("-D", "--output-delimiter", help="Output field delimiter. Defaults to the input delimiter.")
    parser.add_argument(
        "--sort-by-value", action="store_true", help="Sort by the first aggregated value. Default is descending."
    )
    parser.add_argument("-r", "--reverse", action="store_true", help="Reverse the sort order.")
    parser.add_argument(
        "-p", "--percentage", action="store_true", help="Show percentage for sum/count and add a total row."
    )
    parser.add_argument("-P", "--pretty", action="store_true", help="Print output in a pretty, aligned table.")
    parser.add_argument("-i", "--ignore-errors", action="store_true", help="Ignore lines that cause errors.")
    parser.add_argument(
        "files",
        nargs="*",
        type=argparse.FileType("r"),
        default=[sys.stdin],
        help="Input files. Reads from stdin if not specified.",
    )

    args = parser.parse_args()

    if args.all_aggs:
        args.agg = ["sum", "count", "avg", "min", "max"]

    input_delimiter = unescape_str(args.delimiter)
    output_delimiter = unescape_str(args.output_delimiter) if args.output_delimiter is not None else input_delimiter

    try:
        key_cols = parse_column_spec(args.key_cols) if args.key_cols else []
        value_cols = parse_column_spec(args.value_cols) if args.value_cols else []
    except ValueError as e:
        parser.error(str(e))

    if value_cols:
        base_aggs = ["count", "sum"]
        extra_aggs = args.agg or []
    else:
        base_aggs = ["count"]
        extra_aggs = args.agg or []
    agg_funcs = base_aggs + [agg for agg in extra_aggs if agg not in base_aggs]

    raw_results, error_count = process_streams(args.files, input_delimiter, key_cols, value_cols, args.ignore_errors)

    # --- Data Processing in correct column order ---
    final_results = []
    for key, aggregators in raw_results.items():
        row_values = []
        for agg in aggregators:  # Outer loop: by value column
            for agg_func in agg_funcs:  # Inner loop: by aggregation function
                row_values.append(agg.get(agg_func))
        final_results.append({"key": key, "values": row_values})

    # --- Totals and Percentages ---
    num_value_cols = len(value_cols) if value_cols else 1
    num_agg_funcs = len(agg_funcs)
    global_aggregators = [Aggregator() for _ in range(num_value_cols)]
    for aggs_list in raw_results.values():
        for i, agg in enumerate(aggs_list):
            global_aggregators[i].merge(agg)

    grand_totals = []
    for agg in global_aggregators:  # Outer loop: by value column
        for agg_func in agg_funcs:  # Inner loop: by aggregation function
            grand_totals.append(agg.get(agg_func))

    if args.percentage:
        for res in final_results:
            new_values = []
            for i, val in enumerate(res["values"]):
                new_values.append(val)
                agg_func_for_this_col = agg_funcs[i % num_agg_funcs]
                if agg_func_for_this_col in ["sum", "count"]:
                    total = grand_totals[i]
                    pct = (val / total * 100) if total != 0 else 0
                    new_values.append(f"{pct:.2f}%")
            res["values"] = new_values

    # --- Sorting ---
    sort_reverse = args.reverse
    if args.sort_by_value:
        final_results.sort(key=lambda x: x["values"][0], reverse=not sort_reverse)
    else:
        final_results.sort(key=lambda x: x["key"], reverse=sort_reverse)

    # --- Header and Output Formatting ---
    header = [f"key_{k}" for k in key_cols]
    v_headers = value_cols if value_cols else [0]
    for v_col in v_headers:  # Outer loop: by value column
        for agg_func in agg_funcs:  # Inner loop: by aggregation function
            base_header = f"{agg_func}_{v_col}"
            header.append(base_header)
            if args.percentage and agg_func in ["sum", "count"]:
                header.append(f"{base_header}_pct")

    data_rows_str = []
    for res in final_results:
        key_str = list(res["key"])
        values_str = [str(v) if isinstance(v, str) else format_value(v) for v in res["values"]]
        data_rows_str.append(key_str + values_str)

    total_row_str = None
    if args.percentage and final_results:
        total_row_keys = ["total"] + [""] * (len(key_cols) - 1) if key_cols else []
        total_values = []
        for i, val in enumerate(grand_totals):
            total_values.append(format_value(val))
            agg_func_for_this_col = agg_funcs[i % num_agg_funcs]
            if agg_func_for_this_col in ["sum", "count"]:
                total_values.append("100.00%")
        total_row_str = total_row_keys + total_values

    # --- Final Print ---
    if args.pretty:
        pretty_print_table(header, data_rows_str, total_row_str)
    else:
        for row in data_rows_str:
            print(output_delimiter.join(row))
        if total_row_str:
            print(output_delimiter.join(total_row_str))

    if error_count > 0:
        print(f"Encountered {error_count} errors.", file=sys.stderr)

    for f in args.files:
        if f is not sys.stdin:
            f.close()


if __name__ == "__main__":
    main()
