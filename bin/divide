#!/usr/bin/env python3
import argparse
import sys
from typing import Callable, Dict, List, TextIO, Tuple


def create_value_getter(spec: str) -> Callable[[List[str]], float]:
    """
    Creates a function that gets a value from a line.
    'v123' -> returns 123.0
    '0'    -> returns the value from column 0
    """
    if spec.startswith("v"):
        try:
            value = float(spec[1:])
            return lambda fields: value
        except (ValueError, TypeError):
            raise ValueError(f"Invalid literal value in spec: '{spec}'")
    else:
        try:
            col_idx = int(spec)
            return lambda fields: float(fields[col_idx])
        except (ValueError, TypeError):
            raise ValueError(f"Invalid column index in spec: '{spec}'")



def safe_divide(numerator: float, denominator: float, default: str = "N/A", as_percent: bool = False) -> str:
    """Safely divides numerator by denominator, returning default if denominator is 0."""
    try:
        if denominator == 0:
            raise ZeroDivisionError
        value = numerator / denominator
        if as_percent:
            return f"{value * 100:.2f}%"
        else:
            return f"{value:.4f}"
    except (ValueError, TypeError, ZeroDivisionError):
        return default


def process_line(
    line: str,
    division_specs: List[Tuple],
    column_totals: Dict[str, float],
    delim: str,
    default_value: str,
    as_percent: bool,
) -> List[str]:
    """Processes a single line of input, performing the specified divisions."""
    line = line.rstrip("\n")
    fields = [x.strip() for x in line.split(delim)]
    try:
        for (numerator_getter, ns_spec_str), denominator_spec in division_specs:
            numerator_val = numerator_getter(fields)

            if denominator_spec is None:  # Division by column total
                total = column_totals.get(ns_spec_str)
                if total is None:
                    fields.append(default_value)
                    continue
                denominator_val = total
            else:
                denominator_getter = create_value_getter(denominator_spec)
                denominator_val = denominator_getter(fields)

            fields.append(safe_divide(numerator_val, denominator_val, default=default_value, as_percent=as_percent))
    except IndexError:
        print(
            f"Error: A specified column index is out of bounds for the line: '{line.strip()}'",
            file=sys.stderr,
        )
    except (ValueError, TypeError):
        print(
            f"Error: Could not convert a value to a number in line: '{line.strip()}'",
            file=sys.stderr,
        )
    return fields



def parse_arguments() -> argparse.Namespace:
    """Parses command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Perform division on columnar data. New columns are appended to the end of each line.",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    parser.add_argument("-d", "--delim", default="\t", help="Input field delimiter. Default is tab.")
    parser.add_argument("-D", "--DELIM", default="\t", help="Output field delimiter. Default is tab.")
    parser.add_argument(
        "-e",
        "--divide_exception_default",
        default="N/A",
        help="Default value for division errors (e.g., division by zero). Default is 'N/A'.",
    )
    parser.add_argument(
        "-P", "--percent", action="store_true", help="Format the output as a percentage (e.g., 0.5 -> 50.00%%)."
    )

    # --- Division Specifiers ---
    group = parser.add_argument_group(
        "division specifiers",
        "Specify the division operations. Use one or more of the following options. They are executed in order.",
    )
    group.add_argument(
        "-p",
        dest="p_specs",
        action="append",
        metavar="SPEC",
        help="""Legacy specifier for division. Can be used multiple times.
Examples:
  '0,1'      - Divide column 0 by column 1.
  '0,v100'   - Divide column 0 by the literal value 100.
  '0'        - Divide column 0 by its column total.
             (Note: reads the entire file into memory)""",
    )
    group.add_argument(
        "--col-by-col",
        dest="cbc_specs",
        action="append",
        metavar="NUM_IDX,DENOM_IDX",
        help="Divide column by another column. Example: '0,1'",
    )
    group.add_argument(
        "--col-by-val",
        dest="cbv_specs",
        action="append",
        metavar="IDX,VALUE",
        help="Divide column by a literal value. Example: '0,100'",
    )
    group.add_argument(
        "--col-by-total",
        dest="cbt_specs",
        action="append",
        metavar="IDX",
        help="Divide column by its total sum. (Note: reads the entire file into memory)",
    )

    parser.add_argument("files", nargs="*", type=argparse.FileType("r"), default=[sys.stdin])
    args = parser.parse_args()

    # --- Consolidate all specs into a single list ---
    args.division_specs = []
    if args.p_specs:
        args.division_specs.extend(args.p_specs)
    if args.cbc_specs:
        args.division_specs.extend(args.cbc_specs)
    if args.cbv_specs:
        # Add 'v' prefix for value-based specs
        args.division_specs.extend([f"{spec.split(',')[0]},v{spec.split(',')[1]}" for spec in args.cbv_specs])
    if args.cbt_specs:
        args.division_specs.extend(args.cbt_specs)

    if not args.division_specs:
        parser.error("At least one division specifier (-p, --col-by-col, etc.) is required.")

    return args


def main():
    """Main execution function."""
    args = parse_arguments()

    # --- Prepare division specifications ---
    division_specs = []
    needs_column_totals = False
    for spec in args.division_specs:
        try:
            parts = spec.split(",")
            if not 1 <= len(parts) <= 2:
                raise ValueError("Spec must have 1 or 2 parts")
            
            numerator_spec = parts[0]
            denominator_spec = parts[1] if len(parts) > 1 else None

            numerator_getter = create_value_getter(numerator_spec)
            division_specs.append(((numerator_getter, numerator_spec), denominator_spec))

            if denominator_spec is None and not numerator_spec.startswith("v"):
                needs_column_totals = True
        except ValueError as e:
            parser.error(f"Invalid division specifier '{spec}': {e}")

    # --- Pre-pass to calculate totals if needed ---
    column_totals = {}
    stored_lines = []

    infiles = args.files
    if not infiles:
        infiles = [sys.stdin]

    # We must read all lines to calculate totals accurately
    for fd in infiles:
        stored_lines.extend(fd.readlines())

    if needs_column_totals:
        for line in stored_lines:
            fields = [x.strip() for x in line.strip("\n").split(args.delim)]
            for (numerator_getter, numerator_spec_str), denominator_spec in division_specs:
                if denominator_spec is None and not numerator_spec_str.startswith("v"):
                    try:
                        value = float(fields[int(numerator_spec_str)])
                        column_totals[numerator_spec_str] = column_totals.get(numerator_spec_str, 0) + value
                    except (ValueError, IndexError):
                        continue  # Ignore lines/fields that can't be converted to float

    # --- Main processing pass ---
    for line in stored_lines:
        result_fields = process_line(
            line,
            division_specs,
            column_totals,
            args.delim,
            args.divide_exception_default,
            args.percent,
        )
        print(args.DELIM.join(map(str, result_fields)))


if __name__ == "__main__":
    main()
