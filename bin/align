#!/usr/bin/env python3
"""
align is a command-line tool for formatting delimited data into a
well-aligned, human-readable table. It reads from stdin and writes to stdout.
"""

import argparse
import re
import shlex
import subprocess
import sys
import textwrap


def strip_ansi(text: str) -> str:
    """
    Removes ANSI escape codes (for colors, bold, etc.) from a string.
    This is crucial for correctly calculating the visible width of the text.
    """
    if not text:
        return ""
    # Regex to match ANSI escape codes.
    ansi_escape = re.compile(r"(\x1B(?:[@-Z\-_]|[\[0-?]*[ -/]*[@-~]))")
    return ansi_escape.sub("", text)


def run_tests():
    """Runs a series of self-tests to verify the script's functionality."""
    script_path = __file__
    test_cases = [
        {
            "name": "Test 1: Basic tab-delimited input",
            "args": "",
            "input": "a\tb\tlong column\naaa\tbb\tc",
            "output": textwrap.dedent("""
            a  b  long column
            aaa  bb  c""").strip(),
        },
        {
            "name": "Test 2: Comma delimiter",
            "args": "-d ,",
            "input": "header1,header2\nvalue1,value2",
            "output": textwrap.dedent("""
            header1  header2
            value1  value2""").strip(),
        },
        {
            "name": "Test 3: --header flag",
            "args": "--header",
            "input": "Name\tAge\nLinus\t55\nGemini\t1",
            "output": textwrap.dedent("""
            Name    Age
            ----    ---
            Linus   55
            Gemini  1""").strip(),
        },
        {
            "name": "Test 4: --set-header flag",
            "args": '--set-header "User,Role,ID"',
            "input": "user1\tadmin\t101\nuser2\tdev\t102",
            "output": textwrap.dedent("""
            User   Role   ID
            ----   ----   ---
            user1  admin  101
            user2  dev    102""").strip(),
        },
        {
            "name": "Test 5: Input with ANSI color codes",
            "args": "--header",
            "input": "\x1b[1mName\x1b[0m\tStatus\nAlice\t\x1b[32mOK\x1b[0m\nBob\t\x1b[31mFAIL\x1b[0m",
            "output": textwrap.dedent("""
            \x1b[1mName\x1b[0m   Status
            ----   ------
            Alice  \x1b[32mOK\x1b[0m
            Bob    \x1b[31mFAIL\x1b[0m""").strip(),
        },
        {
            "name": "Test 6: Custom separator",
            "args": "-s ' | '",
            "input": "a,b\nc,d",
            "input_delimiter": "-d ,",
            "output": textwrap.dedent("""
            a | b
            c | d""").strip(),
        },
        {
            "name": "Test 7: Empty input",
            "args": "",
            "input": "",
            "output": "",
        },
        {
            "name": "Test 8: Mismatched columns",
            "args": "--header",
            "input": "H1\tH2\tH3\nval1\tval2\nvalA\tvalB\tvalC\tvalD",
            "output": textwrap.dedent("""
            H1    H2    H3    
            --    --    --    ----
            val1  val2        
            valA  valB  valC  valD""").strip(),
        },
    ]

    print(f"Running {len(test_cases)} tests...\n")
    failures = 0
    for i, case in enumerate(test_cases):
        print(f"--- {case['name']} ---")
        args_list = shlex.split(case["args"])
        if case.get("input_delimiter"):
            args_list.extend(shlex.split(case["input_delimiter"]))
        command = [sys.executable, script_path] + args_list

        try:
            process = subprocess.run(
                command,
                input=case["input"],
                capture_output=True,
                text=True,
                check=True,
                encoding="utf-8",
            )

            actual_output = process.stdout.strip()
            expected_output = case["output"].strip()

            if actual_output == expected_output:
                print("\033[92mPASS\033[0m")
            else:
                failures += 1
                print("\033[91mFAIL\033[0m")
                print("Expected:")
                print(textwrap.indent(expected_output, "> "))
                print("Got:")
                print(textwrap.indent(actual_output, "> "))

        except subprocess.CalledProcessError as e:
            failures += 1
            print("\033[91mFAIL (Process Error)\033[0m")
            print(f"Return code: {e.returncode}")
            print(f"Stdout: {e.stdout}")
            print(f"Stderr: {e.stderr}")
        print()

    if failures > 0:
        print(f"Result: {failures} of {len(test_cases)} tests failed.")
        sys.exit(1)
    else:
        print("Result: All tests passed.")
        sys.exit(0)


def main():
    """Main execution function."""
    parser = argparse.ArgumentParser(
        description="Format delimited data into a well-aligned table.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("-d", "--delimiter", default="\t", help="Input field delimiter. Defaults to tab.")
    parser.add_argument(
        "-s", "--separator", default="  ", help="Separator between columns in the output. Defaults to two spaces."
    )
    parser.add_argument("--header", action="store_true", help="Treat the first line of input as a header row.")
    parser.add_argument("--set-header", help="Define a custom header, e.g., 'col1,col2'. Assumes comma-separated.")
    parser.add_argument("--test", action="store_true", help="Run internal self-tests and exit.")

    args = parser.parse_args()

    if args.test:
        run_tests()
        return

    # 1. Read data from stdin
    all_lines = sys.stdin.readlines()
    if not all_lines and not args.set_header:
        return

    # 2. Determine header and data rows
    header_cols = None
    data_lines = all_lines

    if args.set_header:
        header_cols = args.set_header.split(",")
    elif args.header and all_lines:
        header_cols = all_lines[0].rstrip("\n").split(args.delimiter)
        data_lines = all_lines[1:]

    if not header_cols:
        for line in all_lines:
            print(args.separator.join(line.rstrip("\n").split(args.delimiter)))
        return

    rows = []
    for line in data_lines:
        rows.append(line.rstrip("\n").split(args.delimiter))

    all_rows = [header_cols] + rows
    num_cols = max((len(r) for r in all_rows), default=0)
    for r in all_rows:
        if len(r) < num_cols:
            r.extend([""] * (num_cols - len(r)))

    max_widths = {}
    for r in all_rows:
        for i, cell in enumerate(r):
            w = len(strip_ansi(cell))
            max_widths[i] = max(max_widths.get(i, 0), w)

    sep = args.separator
    sep_is_space = sep.strip() == ""
    sep_len = len(sep)

    def format_row(r):
        parts = []
        for i in range(num_cols):
            cell = r[i]
            vis = len(strip_ansi(cell))
            pad = max_widths.get(i, 0) - vis
            if i < num_cols - 1:
                if sep_is_space:
                    parts.append(cell + (" " * (pad + sep_len)))
                else:
                    parts.append(cell + (" " * pad) + sep)
            else:
                parts.append(cell)
        return "".join(parts)

    print(format_row(header_cols + [""] * (num_cols - len(header_cols))))

    underline = []
    for i in range(num_cols):
        if i < len(header_cols):
            if i == len(header_cols) - 1 and num_cols == len(header_cols):
                underline.append("-" * max_widths.get(i, 0))
            else:
                underline.append("-" * len(strip_ansi(header_cols[i])))
        else:
            underline.append("")
    # For columns beyond header, ensure no extra dashes appear
    print(format_row(underline[: len(header_cols)] + [""] * (num_cols - len(header_cols))))

    for r in rows:
        if len(r) < num_cols:
            r = r + [""] * (num_cols - len(r))
        print(format_row(r))


if __name__ == "__main__":
    main()
