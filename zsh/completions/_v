#compdef v

typeset -A opt_args
local context state line

_arguments -S \
  '(-d)-c[current directory]' \
  '(-c)-d+[specify directory]:directory:_files -/' \
  '-a[include deleted files]' \
  '-l[list mode]' \
  '-h[help]' \
  '--help[help]' \
  '--debug[show debug info]' \
  '(-)::args:->file-or-word' \
  && return 0

case "$state" in
  file-or-word)
    local -a cmd=(v -l)
    (( $+opt_args[-c] )) && cmd+=(-c)
    (( $+opt_args[-d] )) && cmd+=("-d$opt_args[-d]")
    (( $+opt_args[-a] )) && cmd+=(-a)
    local -a files=(${(f)"$(${cmd[@]} 2>/dev/null | cut -f2)"})
    (( $#files )) && _values 'files' ${(Oa)files} && return 0
    ;;
esac

return 1
